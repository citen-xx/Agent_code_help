# LLM provider (OpenAI-compatible API). Fill in your real values — never commit real keys.
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://your-api-base-url
LLM_MODEL=your-model-name

# Workspace storage (cloned repositories stay under this root)
WORKSPACE_ROOT=.workspaces
WORKSPACE_CLONE_TIMEOUT_SECONDS=300
BUILD_TEST_TIMEOUT_SECONDS=300

# Docker Maven sandbox (network is always disabled inside the container)
DOCKER_MAVEN_IMAGE=maven:3.9-eclipse-temurin-17
DOCKER_MAVEN_CPUS=1.0
DOCKER_MAVEN_MEMORY=1g
DOCKER_MAVEN_PIDS_LIMIT=256
DOCKER_MAVEN_TMPFS_SIZE=256m
